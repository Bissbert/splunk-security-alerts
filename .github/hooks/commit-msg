#!/usr/bin/env bash
# Git hook to prevent commits with prohibited attribution terms
# Install by copying to .git/hooks/commit-msg and making executable

msg_file="$1"

# Block explicit attribution or "generated by" phrasing
if grep -E -i '\b(claude|anthropic)\b' "$msg_file"; then
  echo "✖ Commit message contains disallowed attribution terms." >&2
  echo "  Please remove references to specific AI tools or services." >&2
  exit 1
fi

if grep -E -i '(generated by|auto-?generated|ai-generated|llm-generated|machine-generated)' "$msg_file"; then
  echo "✖ Commit message must not state that content was generated." >&2
  echo "  Please rephrase to focus on the changes themselves." >&2
  exit 1
fi

# Remove any Co-authored-by lines referencing tools/agents (silent cleanup)
tmp_file="$(mktemp)"
grep -Ev -i '^(Co-authored-by: ).*(claude|anthropic|chatgpt|assistant|copilot)' "$msg_file" > "$tmp_file"
mv "$tmp_file" "$msg_file"

exit 0