<dashboard version="1.1">
  <label>SSH Security Monitoring</label>
  <description>Comprehensive SSH access monitoring and threat detection</description>
  <row>
    <panel>
      <title>SSH Access Overview - Last 24 Hours</title>
      <single>
        <search>
          <query>
            index=* source="/var/log/secure*" OR source="/var/log/auth*" sshd
            | rex field=_raw "sshd\[\d+\]:\s+(?&lt;ssh_status&gt;Accepted|Failed)"
            | stats count
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <refresh>1m</refresh>
        </search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="underLabel">Total SSH Events</option>
        <option name="useColors">0</option>
      </single>
    </panel>
    <panel>
      <title>Successful SSH Logins</title>
      <single>
        <search>
          <query>
            index=* source="/var/log/secure*" OR source="/var/log/auth*"
            | rex field=_raw "sshd\[\d+\]:\s+Accepted"
            | stats count
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <refresh>1m</refresh>
        </search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x65A637","0xF7BC38","0xF58F39"]</option>
        <option name="rangeValues">[0,100,500]</option>
        <option name="underLabel">Successful Logins</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <title>Failed SSH Attempts</title>
      <single>
        <search>
          <query>
            index=* source="/var/log/secure*" OR source="/var/log/auth*"
            | rex field=_raw "sshd\[\d+\]:\s+Failed"
            | stats count
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <refresh>1m</refresh>
        </search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x65A637","0xF7BC38","0xF58F39","0xD93F3C"]</option>
        <option name="rangeValues">[0,50,200,500]</option>
        <option name="underLabel">Failed Attempts</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <title>Unauthorized Access Attempts</title>
      <single>
        <search>
          <query>
            index=* source="/var/log/secure*" OR source="/var/log/auth*"
            | rex field=_raw "sshd\[\d+\]:\s+Accepted\s+\S+\s+for\s+(?&lt;user&gt;\S+)\s+from\s+(?&lt;src_ip&gt;\S+)"
            | lookup authorized_ips.csv src_ip OUTPUT authorized
            | where NOT authorized="true"
            | stats count
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <refresh>1m</refresh>
        </search>
        <option name="drilldown">none</option>
        <option name="colorBy">value</option>
        <option name="colorMode">block</option>
        <option name="rangeColors">["0x65A637","0xF58F39","0xD93F3C"]</option>
        <option name="rangeValues">[0,1,5]</option>
        <option name="underLabel">Unauthorized IPs</option>
        <option name="useColors">1</option>
      </single>
    </panel>
  </row>

  <row>
    <panel>
      <title>SSH Access Pattern Timeline</title>
      <chart>
        <search>
          <query>
            index=* source="/var/log/secure*" OR source="/var/log/auth*" sshd
            | rex field=_raw "sshd\[\d+\]:\s+(?&lt;ssh_status&gt;Accepted|Failed)"
            | timechart span=1h count by ssh_status
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <refresh>5m</refresh>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueMode">connect</option>
        <option name="charting.axisTitleX.text">Time</option>
        <option name="charting.axisTitleY.text">SSH Events</option>
        <option name="charting.legend.placement">bottom</option>
        <option name="charting.fieldColors">{"Accepted":"#65A637","Failed":"#D93F3C"}</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Geographic Distribution of SSH Connections</title>
      <map>
        <search>
          <query>
            index=* source="/var/log/secure*" OR source="/var/log/auth*"
            | rex field=_raw "from\s+(?&lt;src_ip&gt;\d+\.\d+\.\d+\.\d+)"
            | iplocation src_ip
            | stats count by src_ip, Country, City, lat, lon
            | geostats latfield=lat longfield=lon count
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <refresh>10m</refresh>
        </search>
        <option name="drilldown">all</option>
        <option name="mapping.type">marker</option>
        <option name="mapping.markerLayer.markerMaxSize">50</option>
        <option name="mapping.markerLayer.markerMinSize">10</option>
      </map>
    </panel>
    <panel>
      <title>SSH Authentication Methods</title>
      <chart>
        <search>
          <query>
            index=* source="/var/log/secure*" OR source="/var/log/auth*"
            | rex field=_raw "sshd\[\d+\]:\s+Accepted\s+(?&lt;auth_method&gt;\S+)"
            | stats count by auth_method
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <refresh>5m</refresh>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.legend.placement">right</option>
      </chart>
    </panel>
  </row>

  <row>
    <panel>
      <title>Top SSH Source IPs</title>
      <table>
        <search>
          <query>
            index=* source="/var/log/secure*" OR source="/var/log/auth*"
            | rex field=_raw "from\s+(?&lt;src_ip&gt;\d+\.\d+\.\d+\.\d+)"
            | rex field=_raw "sshd\[\d+\]:\s+(?&lt;ssh_status&gt;Accepted|Failed)"
            | stats count as total, sum(eval(if(ssh_status="Accepted",1,0))) as successful, sum(eval(if(ssh_status="Failed",1,0))) as failed by src_ip
            | lookup authorized_ips.csv src_ip OUTPUT authorized description
            | fillnull value="false" authorized
            | fillnull value="Unknown" description
            | eval success_rate=round((successful/total)*100, 2)
            | sort -total
            | head 15
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <refresh>5m</refresh>
        </search>
        <option name="drilldown">cell</option>
        <option name="count">15</option>
        <format type="color" field="authorized">
          <colorPalette type="map">{"true":"#65A637","false":"#D93F3C"}</colorPalette>
        </format>
        <format type="color" field="failed">
          <colorPalette type="minMidMax" maxColor="#D93F3C" midColor="#F7BC38" minColor="#65A637"></colorPalette>
          <scale type="minMidMax" midType="percentile" midValue="50"></scale>
        </format>
      </table>
    </panel>
    <panel>
      <title>Top SSH Target Users</title>
      <table>
        <search>
          <query>
            index=* source="/var/log/secure*" OR source="/var/log/auth*"
            | rex field=_raw "for\s+(?:invalid user\s+)?(?&lt;user&gt;\S+)\s+from"
            | rex field=_raw "sshd\[\d+\]:\s+(?&lt;ssh_status&gt;Accepted|Failed)"
            | stats count as attempts, sum(eval(if(ssh_status="Accepted",1,0))) as successful, sum(eval(if(ssh_status="Failed",1,0))) as failed by user
            | lookup authorized_users.csv user OUTPUT is_admin
            | fillnull value="false" is_admin
            | eval risk_level=case(
                is_admin="true" AND failed>10, "critical",
                is_admin="true", "high",
                failed>50, "medium",
                1=1, "low"
            )
            | sort -attempts
            | head 15
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <refresh>5m</refresh>
        </search>
        <option name="drilldown">cell</option>
        <option name="count">15</option>
        <format type="color" field="risk_level">
          <colorPalette type="map">{"critical":"#D93F3C","high":"#F58F39","medium":"#F7BC38","low":"#65A637"}</colorPalette>
        </format>
        <format type="color" field="is_admin">
          <colorPalette type="map">{"true":"#F58F39","false":"#65A637"}</colorPalette>
        </format>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Failed Login Patterns</title>
      <chart>
        <search>
          <query>
            index=* source="/var/log/secure*" OR source="/var/log/auth*" "Failed password"
            | rex field=_raw "for\s+(?:invalid user\s+)?(?&lt;user&gt;\S+)\s+from\s+(?&lt;src_ip&gt;\S+)"
            | bin _time span=15m
            | stats count by _time, src_ip
            | where count > 5
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <refresh>5m</refresh>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.chart.stackMode">stacked</option>
        <option name="charting.axisTitleX.text">Time</option>
        <option name="charting.axisTitleY.text">Failed Attempts</option>
        <option name="charting.legend.placement">bottom</option>
      </chart>
    </panel>
    <panel>
      <title>Brute Force Detection</title>
      <table>
        <search>
          <query>
            index=* source="/var/log/secure*" OR source="/var/log/auth*" "Failed password"
            | rex field=_raw "for\s+(?:invalid user\s+)?(?&lt;user&gt;\S+)\s+from\s+(?&lt;src_ip&gt;\S+)"
            | bin _time span=5m
            | stats count as attempts, dc(user) as unique_users by _time, src_ip
            | where attempts > 10
            | eval attack_type=case(
                unique_users > 5, "User Enumeration",
                unique_users = 1, "Password Spraying",
                1=1, "Brute Force"
            )
            | sort -attempts
            | head 20
          </query>
          <earliest>-4h@h</earliest>
          <latest>now</latest>
          <refresh>2m</refresh>
        </search>
        <option name="drilldown">cell</option>
        <option name="count">20</option>
        <format type="color" field="attempts">
          <colorPalette type="minMidMax" maxColor="#D93F3C" midColor="#F7BC38" minColor="#F7BC38"></colorPalette>
          <scale type="minMidMax" minValue="10" midType="percentile" midValue="50"></scale>
        </format>
        <format type="color" field="attack_type">
          <colorPalette type="map">{"User Enumeration":"#D93F3C","Password Spraying":"#F58F39","Brute Force":"#F7BC38"}</colorPalette>
        </format>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Recent Unauthorized SSH Access</title>
      <table>
        <search>
          <query>
            index=* source="/var/log/secure*" OR source="/var/log/auth*"
            | rex field=_raw "sshd\[\d+\]:\s+Accepted\s+(?&lt;auth_method&gt;\S+)\s+for\s+(?&lt;user&gt;\S+)\s+from\s+(?&lt;src_ip&gt;\S+)\s+port\s+(?&lt;src_port&gt;\d+)"
            | lookup authorized_ips.csv src_ip OUTPUT authorized
            | where NOT authorized="true"
            | iplocation src_ip
            | eval time=strftime(_time, "%Y-%m-%d %H:%M:%S")
            | table time, src_ip, Country, City, user, auth_method, host
            | sort -_time
            | head 50
          </query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
          <refresh>1m</refresh>
        </search>
        <option name="drilldown">cell</option>
        <option name="count">50</option>
        <option name="dataOverlayMode">none</option>
        <option name="rowNumbers">true</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
</dashboard>